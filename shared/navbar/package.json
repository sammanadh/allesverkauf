{
  "name": "@sammanadh/navbar",
  "version": "0.0.1",
  "type": "module",
  "main": "lib-dist/index.cjs",
  "module": "lib-dist/index.js",
  "types": "./lib-dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib-dist/index.d.ts",
        "default": "./lib-dist/index.js"
      },
      "require": {
        "types": "./lib-dist/index.d.cts",
        "default": "./lib-dist/index.cjs"
      }
    }
  },
  "files": [
    "lib-dist"
  ],
  "scripts": {
    "build:lib": "NODE_ENV=production rslib build --config rspack.config.lib.ts",
    "build:dev": "NODE_ENV=development rspack build --config rspack.config.dev.ts",
    "build:start": "cd dist && rspack serve --config rspack.config.dev.ts",
    "start": "NODE_ENV=development rspack serve --config rspack.config.dev.ts"
  }
}