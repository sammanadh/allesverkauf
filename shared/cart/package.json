{
  "name": "@sammanadh/cart",
  "version": "1.0.1",
  "main": "lib-dist/index.cjs",
  "module": "lib-dist/index.js",
  "types": "./lib-dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib-dist/index.d.ts",
        "default": "./lib-dist/index.js"
      },
      "require": {
        "types": "./lib-dist/index.d.cts",
        "default": "./lib-dist/index.cjs"
      }
    }
  },
  "files": [
    "lib-dist"
  ],
  "scripts": {
    "dev:rsbuild": "rsbuild dev --config rsbuild.config.app.ts",
    "build:rsbuild": "rsbuild build --config rsbuild.config.app.ts",
    "preview": "rsbuild preview --config rsbuild.config.app.ts",
    "build:lib": "NODE_ENV=production rslib build --config rsbuild.config.lib.ts",
    "dev:webpack": "webpack serve --config webpack.config.ts",
    "build:webpack": "webpack --mode production --config webpack.config.ts",
    "deploy:webpack": "npm run build:webpack && cd deployments/webpack && vercel link --project allesverkauf_cart_wp --yes && vercel --prod",
    "deploy:rsbuild": "npm run build:rsbuild && cd deployments/rsbuild && vercel link --project allesverkauf_cart_rb --yes && vercel --prod"
  }
}